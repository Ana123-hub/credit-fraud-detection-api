  {
   "cell_type": "markdown",
   "id": "c03970d3",
   "metadata": {},
   "source": [
    "##LGBM Classifier"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "1384c802",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "--- Running 5-Fold CV on 80% Training Set ---\n",
      "Fold 1 PR-AUC: 0.4246\n",
      "Fold 2 PR-AUC: 0.4364\n",
      "Fold 3 PR-AUC: 0.3149\n",
      "Fold 4 PR-AUC: 0.4701\n",
      "Fold 5 PR-AUC: 0.5903\n",
      "\n",
      " Mean CV PR-AUC Score: 0.4473\n",
      "\n",
      " Final Holdout Test PR-AUC: 0.6016\n"
     ]
    }
   ],
   "source": [
    "#Stratified 5-Fold Cross-Validation on Train Set\n",
    "skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n",
    "\n",
    "#Compute algorithmic weighting ratio for loss function\n",
    "scale_pos_weight = (len(y_train) - y_train.sum()) / y_train.sum()\n",
    "\n",
    "cv_pr_aucs = []\n",
    "oof_predictions = np.zeros(len(X_train))\n",
    "\n",
    "print(\"\\n--- Running 5-Fold CV on 80% Training Set ---\")\n",
    "for fold, (train_idx, val_idx) in enumerate(skf.split(X_train, y_train)):\n",
    "    X_tr, y_tr = X_train.iloc[train_idx], y_train.iloc[train_idx]\n",
    "    X_va, y_va = X_train.iloc[val_idx], y_train.iloc[val_idx]\n",
    "    \n",
    "    model_lgb = lgb.LGBMClassifier(\n",
    "        n_estimators=400,\n",
    "        learning_rate=0.03,\n",
    "        num_leaves=31,\n",
    "        scale_pos_weight=scale_pos_weight,\n",
    "        random_state=42,\n",
    "        n_jobs=-1,\n",
    "        verbose=-1\n",
    "    )\n",
    "    \n",
    "    model_lgb.fit(\n",
    "        X_tr, y_tr,\n",
    "        eval_set=[(X_va, y_va)],\n",
    "        eval_metric=\"average_precision\",\n",
    "        callbacks=[lgb.early_stopping(stopping_rounds=30, verbose=False)]\n",
    "    )\n",
    "    \n",
    "    val_probs = model_lgb.predict_proba(X_va)[:, 1]\n",
    "    oof_predictions[val_idx] = val_probs\n",
    "    \n",
    "    fold_score = average_precision_score(y_va, val_probs)\n",
    "    cv_pr_aucs.append(fold_score)\n",
    "    print(f\"Fold {fold + 1} PR-AUC: {fold_score:.4f}\")\n",
    "\n",
    "print(f\"\\n Mean CV PR-AUC Score: {np.mean(cv_pr_aucs):.4f}\")\n",
    "\n",
    "#Final Evaluation on 20% Holdout Test Set\n",
    "#Train final model on entire 80% training set\n",
    "final_lgb = lgb.LGBMClassifier(\n",
    "    n_estimators=300,\n",
    "    learning_rate=0.03,\n",
    "    scale_pos_weight=scale_pos_weight,\n",
    "    random_state=42,\n",
    "    n_jobs=-1,\n",
    "    verbose=-1\n",
    ")\n",
    "final_lgb.fit(X_train, y_train)\n",
    "\n",
    "test_probs = final_lgb.predict_proba(X_test)[:, 1]\n",
    "test_pr_auc = average_precision_score(y_test, test_probs)\n",
    "\n",
    "print(f\"\\n Final Holdout Test PR-AUC: {test_pr_auc:.4f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "b4c6e9da",
   "metadata": {},
   "source": [
    "There is no sign to indicate data leakage according to these results, but just to safe, all preprocessing will take place after train-test split with on a copy of our data."
   ]
  },
  {
   "cell_type": "markdown",
   "id": "a6180abf",
   "metadata": {},
   "source": [
    "##Random Forest Classifier with feature engineering and Robust scaling AFTER Stratified train-test split."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "f294823c",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "--- Running Random Forest 5-Fold CV ---\n",
      "Fold 1 PR-AUC: 0.8383\n",
      "Fold 2 PR-AUC: 0.8555\n",
      "Fold 3 PR-AUC: 0.7638\n",
      "Fold 4 PR-AUC: 0.8494\n",
      "Fold 5 PR-AUC: 0.8486\n",
      "\n",
      " Mean CV PR-AUC Score (Random Forest): 0.8311\n",
      " Final Holdout Test PR-AUC: 0.7965\n"
     ]
    }
   ],
   "source": [
    "# Separate Target\n",
    "y_1 = data_1['Class']\n",
    "X_1 = data_1.drop(columns=['Class'])\n",
    "\n",
    "if 'Unnamed: 0' in X_1.columns:\n",
    "    X_1 = X_1.drop(columns=['Unnamed: 0'])\n",
    "\n",
    "#Clean 80/20 Stratified Train/Test Split\n",
    "X_train_raw, X_test_raw, y_train1, y_test1 = train_test_split(\n",
    "    X_1, y_1, test_size=0.20, stratify=y, random_state=42\n",
    ")\n",
    "\n",
    "#Leak-Free Preprocessing function for Feature engineering and Scaling\n",
    "def process_features(train_df, test_df):\n",
    "    train1 = train_df.copy()\n",
    "    test1 = test_df.copy()\n",
    "    \n",
    "    #Time cyclical encoding\n",
    "    for data in [train1, test1]:\n",
    "        hour = (data['Time'] / 3600) % 24\n",
    "        data['hour_sin'] = np.sin(2 * np.pi * hour / 24.0)\n",
    "        data['hour_cos'] = np.cos(2 * np.pi * hour / 24.0)\n",
    "        data.drop(columns=['Time'], inplace=True)\n",
    "        \n",
    "    #Scale 'Amount' using train-fitted scaler\n",
    "    scaler = RobustScaler()\n",
    "    train1['scaled_amount'] = scaler.fit_transform(train1[['Amount']])\n",
    "    test1['scaled_amount'] = scaler.transform(test1[['Amount']])\n",
    "    \n",
    "    train1.drop(columns=['Amount'], inplace=True)\n",
    "    test1.drop(columns=['Amount'], inplace=True)\n",
    "    \n",
    "    return train1, test1\n",
    "\n",
    "X_train1, X_test1 = process_features(X_train_raw, X_test_raw)\n",
    "\n",
    "#Stratified 5-Fold Cross-Validation with Random Forest\n",
    "skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n",
    "\n",
    "cv_pr_aucs = []\n",
    "oof_probs = np.zeros(len(X_train1))\n",
    "\n",
    "print(\"--- Running Random Forest 5-Fold CV ---\")\n",
    "for fold, (train_idx, val_idx) in enumerate(skf.split(X_train1, y_train1)):\n",
    "    X_tr, y_tr = X_train1.iloc[train_idx], y_train1.iloc[train_idx]\n",
    "    X_va, y_va = X_train1.iloc[val_idx], y_train1.iloc[val_idx]\n",
    "    \n",
    "    #Balanced Random Forest Configuration\n",
    "    rf_model = RandomForestClassifier(\n",
    "        n_estimators=200,\n",
    "        max_depth=12,                        # Constrain depth to prevent leaf overfitting\n",
    "        min_samples_leaf=5,                  # Require at least 5 samples per leaf node\n",
    "        max_features='sqrt',                 # Randomly sample sqrt(N) features per split\n",
    "        class_weight='balanced_subsample',   # Re-balance weights inside each tree's bootstrap\n",
    "        n_jobs=-1,\n",
    "        random_state=42\n",
    "    )\n",
    "    \n",
    "    rf_model.fit(X_tr, y_tr)\n",
    "    \n",
    "    val_probs = rf_model.predict_proba(X_va)[:, 1]\n",
    "    oof_probs[val_idx] = val_probs\n",
    "    \n",
    "    score = average_precision_score(y_va, val_probs)\n",
    "    cv_pr_aucs.append(score)\n",
    "    print(f\"Fold {fold + 1} PR-AUC: {score:.4f}\")\n",
    "\n",
    "print(f\"\\n Mean CV PR-AUC Score (Random Forest): {np.mean(cv_pr_aucs):.4f}\")\n",
    "\n",
    "#Final Evaluation on 20% Holdout Test Set\n",
    "final_rf = RandomForestClassifier(\n",
    "    n_estimators=250,\n",
    "    max_depth=12,\n",
    "    min_samples_leaf=5,\n",
    "    max_features='sqrt',\n",
    "    class_weight='balanced_subsample',\n",
    "    n_jobs=-1,\n",
    "    random_state=42\n",
    ")\n",
    "final_rf.fit(X_train1, y_train1)\n",
    "\n",
    "test_probs = final_rf.predict_proba(X_test1)[:, 1]\n",
    "print(f\" Final Holdout Test PR-AUC: {average_precision_score(y_test1, test_probs):.4f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "8a8b75db",
   "metadata": {},
   "source": [
    "#Probability decision threshold tuning/optimisation to see where the model operates best"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "2325b167",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "--- Optimal Decision Threshold ---\n",
      "Best Threshold: 0.5444\n",
      "Optimal F1-Score: 0.8402\n",
      "Precision at Best Threshold: 0.8764\n",
      "Recall at Best Threshold:    0.8069\n",
      "\n",
      "--- Holdout Test Classification Report (At Optimal Threshold) ---\n",
      "              precision    recall  f1-score   support\n",
      "\n",
      "   Legit (0)       1.00      1.00      1.00     56651\n",
      "   Fraud (1)       0.93      0.74      0.82        95\n",
      "\n",
      "    accuracy                           1.00     56746\n",
      "   macro avg       0.97      0.87      0.91     56746\n",
      "weighted avg       1.00      1.00      1.00     56746\n",
      "\n",
      "Confusion Matrix:\n",
      "True Negatives:  56646 | False Positives: 5\n",
      "False Negatives: 25  | True Positives:  70\n"
     ]
    }
   ],
   "source": [
    "#Compute Precision-Recall curve across candidate thresholds\n",
    "precisions, recalls, thresholds = precision_recall_curve(y_train1, oof_probs)\n",
    "\n",
    "#Calculate F1 Score for every threshold\n",
    "f1_scores = 2 * (precisions * recalls) / (precisions + recalls + 1e-10)\n",
    "best_idx = np.argmax(f1_scores)\n",
    "\n",
    "best_threshold = thresholds[best_idx]\n",
    "best_f1 = f1_scores[best_idx]\n",
    "\n",
    "print(f\"--- Optimal Decision Threshold ---\")\n",
    "print(f\"Best Threshold: {best_threshold:.4f}\")\n",
    "print(f\"Optimal F1-Score: {best_f1:.4f}\")\n",
    "print(f\"Precision at Best Threshold: {precisions[best_idx]:.4f}\")\n",
    "print(f\"Recall at Best Threshold:    {recalls[best_idx]:.4f}\")\n",
    "\n",
    "# 3. Evaluate Holdout Test Set using the Optimal Threshold\n",
    "final_test_preds = (test_probs >= best_threshold).astype(int)\n",
    "\n",
    "print(\"\\n--- Holdout Test Classification Report (At Optimal Threshold) ---\")\n",
    "print(classification_report(y_test1, final_test_preds, target_names=['Legit (0)', 'Fraud (1)']))\n",
    "\n",
    "# Confusion Matrix\n",
    "cm = confusion_matrix(y_test1, final_test_preds)\n",
    "print(\"Confusion Matrix:\")\n",
    "print(f\"True Negatives:  {cm[0,0]} | False Positives: {cm[0,1]}\")\n",
    "print(f\"False Negatives: {cm[1,0]}  | True Positives:  {cm[1,1]}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "bf1b93f8",
   "metadata": {},
   "source": [
    "Though we have flagged best threshold at 0.5444 with recall of the positive class (1) at 0.74, it has considerably increased our false negatives while our false alarms (false positives) dropped.\n",
    "For an optimal credit card fraud classifier, we need the false negatives to be as low as possible in spite that the false positives might increase.\n",
    "For the next models we are going to tune the decision threshold around Recall instead of F1 to reduce those false negatives."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "ec4bcdf8",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "--- Random Forest F2-Threshold Optimization Results ---\n",
      "Optimal F2 Decision Threshold: 0.3274\n",
      "OOF Precision at F2 Threshold: 0.8035\n",
      "OOF Recall at F2 Threshold:    0.8439\n",
      "\n",
      "--- Holdout Test Performance (Random Forest at F2 Threshold) ---\n",
      "              precision    recall  f1-score   support\n",
      "\n",
      "   Legit (0)       1.00      1.00      1.00     56651\n",
      "   Fraud (1)       0.81      0.79      0.80        95\n",
      "\n",
      "    accuracy                           1.00     56746\n",
      "   macro avg       0.90      0.89      0.90     56746\n",
      "weighted avg       1.00      1.00      1.00     56746\n",
      "\n",
      "Confusion Matrix:\n",
      "True Negatives:  56633 | False Positives: 18\n",
      "False Negatives: 20  | True Positives:  75\n"
     ]
    }
   ],
   "source": [
    "#Compute F2 score (Weights Recall 2x as much as Precision)\n",
    "f2_scores = (5 * precisions * recalls) / (4 * precisions + recalls + 1e-10)\n",
    "best_f2_idx = np.argmax(f2_scores)\n",
    "best_f2_threshold = thresholds[best_f2_idx]\n",
    "\n",
    "print(\"\\n--- Random Forest F2-Threshold Optimization Results ---\")\n",
    "print(f\"Optimal F2 Decision Threshold: {best_f2_threshold:.4f}\")\n",
    "print(f\"OOF Precision at F2 Threshold: {precisions[best_f2_idx]:.4f}\")\n",
    "print(f\"OOF Recall at F2 Threshold:    {recalls[best_f2_idx]:.4f}\")\n",
    "\n",
    "# 7. Evaluate Holdout Test Set at F2 Threshold\n",
    "final_test_preds_f2 = (test_probs >= best_f2_threshold).astype(int)\n",
    "\n",
    "print(\"\\n--- Holdout Test Performance (Random Forest at F2 Threshold) ---\")\n",
    "print(classification_report(y_test1, final_test_preds_f2, target_names=['Legit (0)', 'Fraud (1)']))\n",
    "\n",
    "cm = confusion_matrix(y_test, final_test_preds_f2)\n",
    "print(\"Confusion Matrix:\")\n",
    "print(f\"True Negatives:  {cm[0,0]} | False Positives: {cm[0,1]}\")\n",
    "print(f\"False Negatives: {cm[1,0]}  | True Positives:  {cm[1,1]}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "fb21dce8",
   "metadata": {},
   "source": [
    "##CatBooost Classifier with F2-based Decision threshold"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "1bd06fdc",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "--- Running CatBoost 5-Fold CV ---\n",
      "Fold 1 PR-AUC: 0.7891\n",
      "Fold 2 PR-AUC: 0.7523\n",
      "Fold 3 PR-AUC: 0.6566\n",
      "Fold 4 PR-AUC: 0.7113\n",
      "Fold 5 PR-AUC: 0.7694\n",
      "\n",
