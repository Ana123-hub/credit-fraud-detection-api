   "source": [
    "from sklearn.ensemble import AdaBoostClassifier\n",
    "from sklearn.tree import DecisionTreeClassifier\n",
    "\n",
    "#Stratified 5-Fold Cross-Validation with AdaBoost\n",
    "skf3 = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n",
    "cv_pr_aucs3 = []\n",
    "oof_probs3 = np.zeros(len(X_train1))\n",
    "\n",
    "# Compute class weights for the base decision tree estimator\n",
    "# AdaBoost doesn't have a native scale_pos_weight parameter, so we pass\n",
    "# class_weight='balanced' directly to the weak decision tree stumps.\n",
    "base_estimator = DecisionTreeClassifier(\n",
    "    max_depth=3,                    # Shallow depth to prevent AdaBoost from overfitting noise\n",
    "    class_weight='balanced',        # Re-weights samples inside base trees\n",
    "    random_state=42\n",
    ")\n",
    "\n",
    "print(\"--- Running AdaBoost 5-Fold CV ---\")\n",
    "for fold, (train_idx, val_idx) in enumerate(skf3.split(X_train1, y_train1)):\n",
    "    X_tr, y_tr = X_train1.iloc[train_idx], y_train1.iloc[train_idx]\n",
    "    X_va, y_va = X_train1.iloc[val_idx], y_train1.iloc[val_idx]\n",
    "    \n",
    "    ada_model = AdaBoostClassifier(\n",
    "        estimator=base_estimator,\n",
    "        n_estimators=100,           # Number of sequential boosting rounds\n",
    "        learning_rate=0.05,         # Lower learning rate dampens exponential weight blowups on outliers\n",
    "        random_state=42\n",
    "    )\n",
    "    \n",
    "    ada_model.fit(X_tr, y_tr)\n",
    "\n",
    "    \n",
    "    val_probs3 = ada_model.predict_proba(X_va)[:, 1]\n",
    "    oof_probs3[val_idx] = val_probs3\n",
    "    \n",
    "    score3 = average_precision_score(y_va, val_probs3)\n",
    "    cv_pr_aucs3.append(score3)\n",
    "    print(f\"Fold {fold + 1} PR-AUC: {score3:.4f}\")\n",
    "\n",
    "print(f\"\\n Mean CV PR-AUC Score (AdaBoost): {np.mean(cv_pr_aucs3):.4f}\")\n",
    "\n",
    "#Fit Final AdaBoost Model on 80% Training Set\n",
    "final_ada = AdaBoostClassifier(\n",
    "    estimator=base_estimator,\n",
    "    n_estimators=100,\n",
    "    learning_rate=0.05,\n",
    "    random_state=42\n",
    ")\n",
    "final_ada.fit(X_train1, y_train1)\n",
    "\n",
    "test_probs_ada = final_ada.predict_proba(X_test1)[:, 1]\n",
    "holdout_pr_auc = average_precision_score(y_test1, test_probs_ada)\n",
    "print(f\" Final Holdout Test PR-AUC: {holdout_pr_auc:.4f}\")"
   ]
