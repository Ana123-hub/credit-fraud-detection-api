   "source": [
    "#Threshold Tuning for Minimal False Negatives (F2-Score Optimization)\n",
    "precisions, recalls, thresholds = precision_recall_curve(y_train1, oof_probs2)\n",
    "\n",
    "#Compute F2 score for every threshold (Weights Recall 2x more than Precision)\n",
    "f2_scores = (5 * precisions * recalls) / (4 * precisions + recalls + 1e-10)\n",
    "best_f2_idx = np.argmax(f2_scores)\n",
    "\n",
    "best_threshold2 = thresholds[best_f2_idx]\n",
    "\n",
    "print(\"\\n--- Low-Threshold Optimization Results ---\")\n",
    "print(f\"Optimal F2 Threshold: {best_threshold2:.4f}\")\n",
    "print(f\"OOF Precision at F2 Threshold: {precisions[best_f2_idx]:.4f}\")\n",
    "print(f\"OOF Recall at F2 Threshold:    {recalls[best_f2_idx]:.4f}\")\n",
    "\n",
    "# 7. Apply Optimized Low Threshold to Holdout Test Set\n",
    "final_preds_low_thresh = (test_probs2 >= best_threshold2).astype(int)\n",
    "\n",
    "print(\"\\n--- Holdout Test Performance (Drastically Reduced False Negatives) ---\")\n",
    "print(classification_report(y_test1, final_preds_low_thresh, target_names=['Legit (0)', 'Fraud (1)']))\n",
    "\n",
    "cm = confusion_matrix(y_test1, final_preds_low_thresh)\n",
    "print(\"Confusion Matrix:\")\n",
    "print(f\"True Negatives:  {cm[0,0]} | False Positives: {cm[0,1]}\")\n",
    "print(f\"False Negatives: {cm[1,0]}  | True Positives:  {cm[1,1]}\")"
   ]
