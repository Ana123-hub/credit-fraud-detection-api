   "source": [
    "from catboost import CatBoostClassifier\n",
    "from sklearn.metrics import average_precision_score, classification_report, confusion_matrix, precision_recall_curve\n",
    "\n",
    "#Stratified 5-Fold Cross-Validation with CatBoost\n",
    "skf_2 = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n",
    "\n",
    "#Compute moderated auto weight for CatBoost (auto_class_weights='Balanced')\n",
    "cv_pr_aucs2 = []\n",
    "oof_probs2 = np.zeros(len(X_train1))\n",
    "\n",
    "print(\"--- Running CatBoost 5-Fold CV ---\")\n",
    "for fold, (train_idx, val_idx) in enumerate(skf_2.split(X_train1, y_train1)):\n",
    "    X_tr, y_tr = X_train1.iloc[train_idx], y_train1.iloc[train_idx]\n",
    "    X_va, y_va = X_train1.iloc[val_idx], y_train1.iloc[val_idx]\n",
    "    \n",
    "    cat_model = CatBoostClassifier(\n",
    "        iterations=600,\n",
    "        learning_rate=0.03,\n",
    "        depth=6,\n",
    "        auto_class_weights='Balanced',  # Automatically scales loss for imbalance\n",
    "        eval_metric='PRAUC',\n",
    "        random_seed=42,\n",
    "        verbose=0\n",
    "    )\n",
    "    \n",
    "    cat_model.fit(\n",
    "        X_tr, y_tr,\n",
    "        eval_set=(X_va, y_va),\n",
    "        early_stopping_rounds=40\n",
    "    )\n",
    "    \n",
    "    val_probs2 = cat_model.predict_proba(X_va)[:, 1]\n",
    "    oof_probs2[val_idx] = val_probs2\n",
    "    \n",
    "    score2 = average_precision_score(y_va, val_probs2)\n",
    "    cv_pr_aucs2.append(score2)\n",
    "    print(f\"Fold {fold + 1} PR-AUC: {score2:.4f}\")\n",
    "\n",
    "print(f\"\\n Mean CV PR-AUC Score (CatBoost): {np.mean(cv_pr_aucs2):.4f}\")\n",
    "\n",
    "#Fit Final CatBoost Model on 80% Training Data\n",
    "final_cat = CatBoostClassifier(\n",
    "    iterations=600,\n",
    "    learning_rate=0.03,\n",
    "    depth=6,\n",
    "    auto_class_weights='Balanced',\n",
    "    eval_metric='PRAUC',\n",
    "    random_seed=42,\n",
    "    verbose=0\n",
    ")\n",
    "final_cat.fit(X_train1, y_train1)\n",
    "\n",
    "test_probs2 = final_cat.predict_proba(X_test1)[:, 1]\n",
    "print(f\" Final Holdout Test PR-AUC: {average_precision_score(y_test1, test_probs2):.4f}\")"
   ]
